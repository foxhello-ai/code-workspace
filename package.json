{
  "name": "code-workspace",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "start": "node dist/server/server/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --update-env",
    "pm2:restart": "pm2 restart code-workspace --update-env",
    "pm2:stop": "pm2 stop code-workspace",
    "pm2:logs": "pm2 logs code-workspace",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:install": "node --test scripts/install.test.mjs scripts/service-manager.test.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.83.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.4.0",
    "lucide-react": "^0.525.0",
    "monaco-editor": "^0.52.2",
    "pm2": "^7.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
